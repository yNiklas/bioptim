version 4
gravity 0 -9.81 0

segment ground
endsegment

marker endeffector_contact_inlet
    parent ground
    position 0 -1.7 0
endmarker

marker endeffector_final
    parent ground
    position 0 -1.3 0
endmarker

segment finger_base
    parent ground
    rt 0 0 0 xyz 0 0.2 0
    translations yz
    rotations x
    mass 0.5
    com 0 0.5 0.2
    inertia
        0.007  0.0000	0.0000
        0.0000	0.042	0.0000
        0.0000	0.0000	0.0488
    mesh 0 0 0
    mesh 0 0 0.4
    mesh 0 1 0.4
    mesh 0 1 0
    mesh 0 0 0
endsegment

contact base_contact
    parent finger_base
    axis yz
endcontact

contact base_contact_2
    parent finger_base
    position 0 1 0
    axis z
endcontact

segment proximal
    parent finger_base
    rt pi/2 0 0 xyz 0 0 0.3
    rotations x
    ranges
        0 0.8*pi
    mass 0.02
    inertia
		0.0833  0.0000	0.0000
		0.0000	0.0833	0.0000
	    0.0000	0.0000	0.0010
    com  0.0000 0.0000 0.5000
    mesh 0 0.05 0
	mesh 0 0.05 1
	mesh 0 -0.05 1
	mesh 0 -0.05 0
	mesh 0 0.05 0
endsegment

segment distal
    parent proximal
    rt 0 0 0 xyz 0 0 1
    rotations x
    ranges
        0 0.8*pi
    mass 0.02
    inertia
        0.0833  0.0000	0.0000
        0.0000	0.0833	0.0000
        0.0000	0.0000	0.0010
    com  0.0000 0.0000 0.5000
    mesh 0 0.05 0
    mesh 0 0.05 1
    mesh 0 -0.05 1
    mesh 0 -0.05 0
    mesh 0 0.05 0
endsegment

contact eff_contact
    parent distal
    position 0 0 1
    axis z
endcontact

marker endeffector
    parent distal
    position 0 0 1
endmarker

tendon t
    origin finger_base
    insertion distal
    originPosition 0 0.1 0.05
    insertionPosition 0 -0.07 0.3
endtendon
tendonRoutingPoint trp1
    tendon t
    parent proximal
    position 0 0.05 0.5
    frictionLoss 0.0
endtendonRoutingPoint

ligament l1
    type linearspring
    origin finger_base
    insertion proximal
    originPosition 0 0.1 0.4
    insertionPosition 0 0.1 0.3
    stiffness 1
    ligamentslacklength 0.3
    dampingfactor 0
    maxshorteningspeed 100
endligament

ligament l2
    type linearspring
    origin proximal
    insertion distal
    originPosition 0 0.1 0.9
    insertionPosition 0 0.1 0.2
    stiffness 1
    ligamentslacklength 0.3
    dampingfactor 0
    maxshorteningspeed 100
endligament
