version 4
gravity 0 0 -9.81

segment ground
endsegment

marker endeffector_contact_inlet
    parent ground
    position 0 -1.8 0
endmarker

marker endeffector_final
    parent ground
    position 0 -1.3 0
endmarker

segment finger_base
    parent ground
    rt 0 0 0 xyz 0 1.7 0.2
    translations yz
    rotations x
    mass 0.5
    com 0 0 0
    inertia
        0.007  0.0000	0.0000
        0.0000	0.38	0.0000
        0.0000	0.0000	0.39
    mesh 0 -1.5 -0.2
    mesh 0 -1.5 0.2
    mesh 0 1.5 0.2
    mesh 0 1.5 -0.2
    mesh 0 -1.5 -0.2
endsegment

    actuator   finger_base
        type    Constant
        dof    TransY
        direction    positive
        Tmax    100.000000
    endactuator
    actuator   finger_base
        type    Constant
        dof    TransY
        direction    negative
        Tmax    50.000000
    endactuator
    actuator   finger_base
        type    Constant
        dof    TransZ
        direction    positive
        Tmax    100.000000
    endactuator
    actuator   finger_base
        type    Constant
        dof    TransZ
        direction    negative
        Tmax    50.000000
    endactuator
    actuator   finger_base
        type    Constant
        dof    RotX
        direction    positive
        Tmax    100.000000
    endactuator
    actuator   finger_base
        type    Constant
        dof    RotX
        direction    negative
        Tmax    50.000000
    endactuator

contact base_contact_left
    parent finger_base
    position 0 -1.5 -0.2
    axis yz
endcontact
marker base_contact_left_marker
    parent finger_base
    position 0 -1.5 -0.2
endmarker

contact base_contact_right
    parent finger_base
    position 0 1.5 -0.2
    axis z
endcontact
marker base_contact_right_marker
    parent finger_base
    position 0 1.5 -0.2
endmarker

segment proximal
    parent finger_base
    rt pi/2 0 0 xyz 0 -1.5 0.1
    rotations x
    ranges
        0 0.8*pi
    mass 0.02
    inertia
		0.0833  0.0000	0.0000
		0.0000	0.0833	0.0000
	    0.0000	0.0000	0.0010
    com  0.0000 0.0000 0.5000
    mesh 0 0.05 0
	mesh 0 0.05 1
	mesh 0 -0.05 1
	mesh 0 -0.05 0
	mesh 0 0.05 0
endsegment

    actuator   proximal
        type    Constant
        dof    RotX
        direction    positive
        Tmax    100.000000
    endactuator
    actuator   proximal
        type    Constant
        dof    RotX
        direction    negative
        Tmax    50.000000
    endactuator

segment distal
    parent proximal
    rt 0 0 0 xyz 0 0 1
    rotations x
    ranges
        0 0.8*pi
    mass 0.02
    inertia
        0.0833  0.0000	0.0000
        0.0000	0.0833	0.0000
        0.0000	0.0000	0.0010
    com  0.0000 0.0000 0.5000
    mesh 0 0.05 0
    mesh 0 0.05 1
    mesh 0 -0.05 1
    mesh 0 -0.05 0
    mesh 0 0.05 0
endsegment

    actuator   distal
        type    Constant
        dof    RotX
        direction    positive
        Tmax    100.000000
    endactuator
    actuator   distal
        type    Constant
        dof    RotX
        direction    negative
        Tmax    50.000000
    endactuator

contact eff_contact
    parent distal
    position 0 0 1
    axis z
endcontact

marker endeffector
    parent distal
    position 0 0 1
endmarker

tendon t
    origin finger_base
    insertion distal
    originPosition 0 -1.4 -0.15
    insertionPosition 0 -0.07 0.3
endtendon
tendonRoutingPoint trp1
    tendon t
    parent proximal
    position 0 0.05 0.5
    frictionLoss 0.0
endtendonRoutingPoint

ligament l1
    type linearspring
    origin finger_base
    insertion proximal
    originPosition 0 -1.5 0.2
    insertionPosition 0 0.1 0.2
    stiffness 500
    ligamentslacklength 0.2
    dampingfactor 0.1
    maxshorteningspeed 100
endligament

ligament l2
    type linearspring
    origin proximal
    insertion distal
    originPosition 0 0.1 1
    insertionPosition 0 0.1 0.2
    stiffness 500
    ligamentslacklength 0.2
    dampingfactor 0.1
    maxshorteningspeed 100
endligament
