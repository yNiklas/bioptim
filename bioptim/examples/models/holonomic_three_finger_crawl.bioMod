// LITTLE FINGER
segment little_proximal
    parent finger_base
    rt pi/2 0 0 xyz -0.04 -0.061 0
    rotations x
    ranges
        0 1.449
    mass 0.01
    inertia
       0.0000012  0.0000  0.0000
       0.0000 0.0000006  0.0000
        0.0000 0.0000 0.0000012
    com  0.0000 0.0000 0.023
    mesh -0.01  0.01 0
    mesh  0.01  0.01 0
    mesh  0.01  0.01 0.046
    mesh -0.01  0.01 0.046
    mesh -0.01  0.01 0
    mesh -0.01 -0.01 0
    mesh  0.01 -0.01 0
    mesh  0.01 -0.01 0.046
    mesh -0.01 -0.01 0.046
    mesh -0.01 -0.01 0
endsegment

segment little_middle
    parent little_proximal
    rt 0 0 0 xyz 0 0 0.046
    rotations x
    ranges
        0 1.396
    mass 0.01
    inertia
        0.0000012  0.0000   0.0000
        0.0000  0.0000006  0.0000
        0.0000  0.0000 0.0000012
    com  0.0000 0.0000 0.023
    mesh -0.01  0.01 0
    mesh  0.01  0.01 0
    mesh  0.01  0.01 0.046
    mesh -0.01  0.01 0.046
    mesh -0.01  0.01 0
    mesh -0.01 -0.01 0
    mesh  0.01 -0.01 0
    mesh  0.01 -0.01 0.046
    mesh -0.01 -0.01 0.046
    mesh -0.01 -0.01 0
endsegment

segment little_distal
    parent little_middle
    rt 0 0 0 xyz 0 0 0.046
    mass 0.01
    rotations x
    ranges
        0 1.396
    inertia
        0.0000012  0.0000   0.0000
        0.0000  0.0000006  0.0000
        0.0000  0.0000 0.0000012
    com  0.0000 0.0000 0.0175
    mesh -0.01  0.01 0
    mesh  0.01  0.01 0
    mesh  0.01  0.01 0.035
    mesh -0.01  0.01 0.035
    mesh -0.01  0.01 0
    mesh -0.01 -0.01 0
    mesh  0.01 -0.01 0
    mesh  0.01 -0.01 0.035
    mesh -0.01 -0.01 0.035
    mesh -0.01 -0.01 0
endsegment

marker little_endeffector
    parent little_distal
    position 0 0 0.035
endmarker
contact little_contact
    parent little_distal
    position 0 0 0.035
    axis z
endcontact

tendon little_t
    origin finger_base
    insertion little_middle
    originPosition -0.04 -0.045 -0.014
    insertionPosition 0 -0.011 0.012
endtendon
tendonRoutingPoint little_trp1
    tendon little_t
    parent little_proximal
    position 0 0.0 0.012
    frictionLoss 0.0
endtendonRoutingPoint
tendonRoutingPoint little_trp2
    tendon little_t
    parent little_proximal
    position 0 0.0 0.028
    frictionLoss 0.0
endtendonRoutingPoint

passivetorque little_proximal
    type linear
    dof RotX
    slope -0.0164
    T0 -0.00736
endpassivetorque

passivetorque little_middle
    type linear
    dof RotX
    slope -0.01888
    T0 -0.00848565
endpassivetorque
